# DEVELOPMENT DATA ONLY. Live payment and shipping execution is not implemented.
# Default database is local .data/studio.db. On Vercel previews use an isolated
# DEVELOPMENT libSQL database, never a production database.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
DATABASE_ENVIRONMENT=development
# Set a long random password to enable /studio. Never use NEXT_PUBLIC_ for secrets.
STUDIO_PASSWORD=
# Optional AI listing drafts: disabled unless BOTH values below are configured.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=

# Optional real provider APIs, SANDBOX ONLY. Demo remains the default.
PAYMENT_PROVIDER=demo
PAYMENT_ENVIRONMENT=sandbox
# Create this key inside a named Recurrente Sandbox. Only sk_test_* is accepted.
RECURRENTE_SECRET_KEY=
RECURRENTE_SANDBOX_ID=
RECURRENTE_WEBHOOK_SECRET=
# Canonical HTTPS Vercel PREVIEW URL; never a production domain in this task.
APP_URL=http://127.0.0.1:3000
# MyDHL Express test account, never live account credentials.
DHL_ENVIRONMENT=sandbox
DHL_TEST_USERNAME=
DHL_TEST_PASSWORD=
DHL_TEST_ACCOUNT=
# A fictional test sender in GT; JSON keys: name,email,phone,address,city,postal,country
DHL_TEST_SHIPPER_JSON=
# Shared fictional GT sender for all test couriers; same JSON keys as above.
SHIPPING_TEST_SHIPPER_JSON=
# Automatic sandbox fulfillment after payment verification (default: true).
SHIPPING_AUTO_BOOK_TEST=true
FORZA_ENVIRONMENT=sandbox
FORZA_TEST_CODAPP=
FORZA_TEST_SECRET=
FORZA_TEST_MERCHANT_ID=
FORZA_TEST_PICKUP_POINT_ID=
# Required only to compare GTQ quotes to USD budgets in development.
# Synthetic test conversion; NOT a verified/live exchange rate. Example: 8.
TEST_GTQ_PER_USD=
FEDEX_ENVIRONMENT=sandbox
FEDEX_TEST_CLIENT_ID=
FEDEX_TEST_CLIENT_SECRET=
FEDEX_TEST_ACCOUNT=
# Guatex: no endpoint/credentials accepted until an official API contract is verified.
# At least 24 random characters for the optional reconciliation cron endpoint.
CRON_SECRET=
