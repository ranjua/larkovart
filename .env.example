# DEVELOPMENT DATA ONLY. Live payment and shipping execution is not implemented.
# Default database is local .data/studio.db. On Vercel previews use an isolated
# DEVELOPMENT libSQL database, never a production database.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
DATABASE_ENVIRONMENT=development
# Admin login: email OTP only, delivered only to larkova.art@gmail.com.
# Sign up for Resend with that email; never use NEXT_PUBLIC_ for this key.
RESEND_API_KEY=
# Optional verified-domain sender; default works only for your Resend account email.
STUDIO_EMAIL_FROM=Larkova Art <onboarding@resend.dev>
# Optional AI listing drafts: disabled unless BOTH values below are configured.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
# Optional Cloudinary photo upload + AI enhancement. API secret stays server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional real provider APIs, SANDBOX ONLY. Demo remains the default.
PAYMENT_PROVIDER=demo
PAYMENT_ENVIRONMENT=sandbox
# Create this key inside a named Recurrente Sandbox. Only sk_test_* is accepted.
RECURRENTE_SECRET_KEY=
RECURRENTE_SANDBOX_ID=
RECURRENTE_WEBHOOK_SECRET=
# Canonical HTTPS Vercel PREVIEW URL; never a production domain in this task.
APP_URL=http://127.0.0.1:3000
# MyDHL Express test account, never live account credentials.
DHL_ENVIRONMENT=sandbox
DHL_TEST_USERNAME=
DHL_TEST_PASSWORD=
DHL_TEST_ACCOUNT=
# A fictional test sender in GT; JSON keys: name,email,phone,address,city,postal,country
DHL_TEST_SHIPPER_JSON=
# Shared fictional GT sender for all test couriers; same JSON keys as above.
SHIPPING_TEST_SHIPPER_JSON=
# Automatic sandbox fulfillment after payment verification (default: true).
SHIPPING_AUTO_BOOK_TEST=true
FORZA_ENVIRONMENT=sandbox
FORZA_TEST_CODAPP=
FORZA_TEST_SECRET=
FORZA_TEST_MERCHANT_ID=
FORZA_TEST_PICKUP_POINT_ID=
# Required only to compare GTQ quotes to USD budgets in development.
# Synthetic test conversion; NOT a verified/live exchange rate. Example: 8.
TEST_GTQ_PER_USD=
FEDEX_ENVIRONMENT=sandbox
FEDEX_TEST_CLIENT_ID=
FEDEX_TEST_CLIENT_SECRET=
FEDEX_TEST_ACCOUNT=
# Guatex: no endpoint/credentials accepted until an official API contract is verified.
# At least 24 random characters for the optional reconciliation cron endpoint.
CRON_SECRET=

# Optional sandbox payment providers: PAYMENT_PROVIDER=stripe or paypal
STRIPE_SECRET_KEY=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
STRIPE_WEBHOOK_SECRET=

ENVIA_SANDBOX_TOKEN=
# Optional saved Guatemala sender address ID, if multiple addresses exist.
ENVIA_TEST_ORIGIN_ID=
# Optional private sender address JSON (name, phone, street, city, state, country GT, postalCode).
ENVIA_TEST_ORIGIN_JSON=

# Social Studio: manual drafting/export works without provider credentials.
SOCIAL_ENABLED=true
SOCIAL_ENVIRONMENT=development
SOCIAL_PUBLISH_ENABLED=false
SOCIAL_TEST_WRITES_ENABLED=false
SOCIAL_WORKER_MODE=manual
SOCIAL_HOSTED_SCHEDULER_VERIFIED=false
# Exact trusted OAuth origin, not inferred from a request Host header.
SOCIAL_ORIGIN=
# Set only after the canonical storefront is confirmed publicly accessible.
SOCIAL_PUBLIC_STORE_VERIFIED=false
SOCIAL_STORE_ORIGIN=
SOCIAL_META_GRAPH_VERSION=v25.0
SOCIAL_TOKEN_ACTIVE_KEY=1
# Dedicated random 32 bytes, standard base64. Never reuse a payment/login key.
SOCIAL_TOKEN_KEY_V1=
SOCIAL_WORKER_SECRET=
SOCIAL_DATABASE_URL=
SOCIAL_DATABASE_AUTH_TOKEN=
SOCIAL_DATABASE_ENVIRONMENT=development
SOCIAL_INSTAGRAM_CLIENT_ID=
SOCIAL_INSTAGRAM_CLIENT_SECRET=
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=
SOCIAL_PINTEREST_CLIENT_ID=
SOCIAL_PINTEREST_CLIENT_SECRET=
# Meta webhook root-app secret; separate from assuming an Instagram login secret.
SOCIAL_META_WEBHOOK_APP_SECRET=
SOCIAL_META_WEBHOOK_VERIFY_TOKEN=
# TikTok remains native/manual; no Direct Post credentials requested.

# Customer accounts (separate from the fixed-email Studio OTP).
# Dedicated random secret, at least 32 characters; unique per environment.
CUSTOMER_AUTH_SECRET=
# Exact HTTPS account origin; localhost HTTP permitted in development only.
CUSTOMER_AUTH_ORIGIN=http://localhost:3000
CUSTOMER_ENVIRONMENT=development
# A verified Resend-domain sender is REQUIRED for public customer emails.
# RESEND_API_KEY above is reused server-side. Do not use onboarding@resend.dev.
CUSTOMER_EMAIL_FROM=
# Google Cloud OAuth Web application. Redirect URI:
# <CUSTOMER_AUTH_ORIGIN>/api/auth/callback/google
CUSTOMER_GOOGLE_CLIENT_ID=
CUSTOMER_GOOGLE_CLIENT_SECRET=
# Optional isolated customer DB. Production requires explicit production storage.
# Preview defaults to customer_* tables on the guarded development commerce DB.
# Local development defaults to a separate .customers SQLite file.
CUSTOMER_DATABASE_URL=
CUSTOMER_DATABASE_AUTH_TOKEN=
CUSTOMER_DATABASE_ENVIRONMENT=development
