{
  "name": "larkovart",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "integrations:check": "node --env-file-if-exists=.env.local scripts/check-integrations.mjs",
    "integrations:register-webhook": "node --env-file-if-exists=.env.local scripts/register-sandbox-webhook.mjs",
    "social:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/social-check-config.ts",
    "social:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/social-migrate.ts",
    "social:worker": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/social-worker.ts",
    "social:rotate-keys": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/social-rotate-keys.ts"
  },
  "dependencies": {
    "@libsql/client": "latest",
    "@libsql/kysely-libsql": "^0.4.1",
    "better-auth": "^1.7.18",
    "kysely": "^0.29.8",
    "lucide-react": "latest",
    "next": "latest",
    "nodemailer": "^10.4.0",
    "react": "latest",
    "react-dom": "latest",
    "svix": "^2.9.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "type": "module"
}
