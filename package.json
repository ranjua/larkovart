{
  "name": "larkovart",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "integrations:check": "node --env-file-if-exists=.env.local scripts/check-integrations.mjs",
    "integrations:register-webhook": "node --env-file-if-exists=.env.local scripts/register-sandbox-webhook.mjs"
  },
  "dependencies": {
    "@libsql/client": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "svix": "^2.9.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "type": "module"
}
